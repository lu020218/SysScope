{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SysScope",
  "version": "0.1.0",
  "identifier": "com.luhaishan.sysscope",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "SysScope - 系统状态监控",
        "width": 1100,
        "height": 760,
        "minWidth": 800,
        "minHeight": 560,
        "decorations": false
      },
      {
        "label": "overlay",
        "url": "overlay.html",
        "title": "SysScope OSD",
        "width": 330,
        "height": 24,
        "x": 40,
        "y": 40,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ws://localhost:1420 http://localhost:1420; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": ["resources/*"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
